# ── Secrets / credentials ──────────────────────────────
.env
.env.*
*.key
*.pem
*credentials*
*secret*

# ── Generated outputs (audio, video, manifests) ───────
# Outputs land in the project's CWD/output/, but if someone
# runs scripts from inside the skill dir, exclude them here too.
output/
output/**

# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────
venv/
.venv/
env/
ENV/

# ── IDE / editor configs ───────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs / temp / cache ────────────────────────────────
*.log
*.tmp
*.jsonl
*.zip
.cache/
.pytest_cache/
htmlcov/
.coverage

# ── OS junk ────────────────────────────────────────────
desktop.ini
ehthumbs.db

# ── 2026-10-27 统一范式补全（与 techdou 仓 .gitignore 标准对齐）──

# ── 私密信息与密钥：绝不入库 ──
*.p12
*.pfx
secrets*
credentials*
*.token
_htpasswd


# ── 开发软件配置目录：本地工具状态不上传 ──
.claude/
.claude.json
.codex/
.cursor/
.gemini/
.zcode/
.windsurf/
.trae/
.roo/
.aider*
continue/
.aws/
.ssh/


# ── 内部文档与开发状态：不入版本控制，避免泄漏 ──
# README.md / CHANGELOG.md / SKILL.md / references/ / evals/ 是仓库正式内容，保持跟踪
drafts/
notes/
private/
internal/
dev/
dev-notes/
.archive/
.research/
*.draft.md
*.local.md
*.wip.md
DEVLOG.md
TODO.md
STATUS.md


# ── Node 前端产物 ──
node_modules/
.next/
.nuxt/
*.tsbuildinfo
